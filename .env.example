# ursked Community Edition — configuration.
#
# Copy this file to .env and fill it in. .env is gitignored and must never be
# committed or shared.
#
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up -d
#
# Generate the two secrets below with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Database ---
POSTGRES_USER=ursked
POSTGRES_PASSWORD=
POSTGRES_DB=ursked

# --- Redis ---
REDIS_PASSWORD=

# --- Application ---
# Leave this as production. It enforces the strict startup checks (no DEBUG, no
# wildcard CORS, Secure cookies). To run over plain HTTP on a trusted network
# WITHOUT dropping to development mode, use ALLOW_INSECURE_TRANSPORT below —
# do NOT change this to development for that.
ENVIRONMENT=production
DEBUG=false

# REQUIRED. Minimum 32 characters. Rotating this signs everyone out.
JWT_SECRET_KEY=

# JSON array. Leave as [] for the default deployment, where the frontend proxies
# /api on the same origin and CORS is unused. If you serve the API on a separate
# origin, list the https frontend origin(s) here.
CORS_ORIGINS=[]

# --- Cookies ---
# Keep COOKIE_SECURE=true whenever the app is reachable over HTTPS (the normal
# production setup, with TLS terminated at your reverse proxy). Set it to false
# only for a no-TLS trial on a trusted network, together with
# ALLOW_INSECURE_TRANSPORT=true below.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- No-TLS trial escape hatch ---
# Secure cookies and https CORS origins require TLS, so production normally
# refuses to start without them. If you are trialling ursked over plain HTTP on
# a trusted network (localhost or a LAN IP, no reverse proxy), set this to true
# AND set COOKIE_SECURE=false above. The app then still runs as production, but
# those two transport checks become loud startup warnings instead of errors.
# DEBUG and wildcard CORS stay hard-blocked. NEVER enable this on anything
# reachable from the internet — put TLS in front and leave it false instead.
ALLOW_INSECURE_TRANSPORT=false

# Expose /docs, /redoc and /openapi.json. Forced off when ENVIRONMENT is
# production or staging.
EXPOSE_API_DOCS=false

# --- Email (SMTP) ---
# Optional. If SMTP_HOST is set, these seed the mail configuration on first boot
# so ursked can send invites, password-reset and notification emails. You can
# also configure SMTP later in the app under Settings -> Email (tenant admin),
# which takes over from these once edited. Leave SMTP_HOST blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on port 587 (typical). For implicit SSL on 465, set SMTP_USE_SSL=true
# and SMTP_USE_TLS=false.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ursked

# --- First-run administrator ---
# Used ONCE, the first time the stack boots against an empty database, to create
# your single organization and its administrator. Changing these later has no
# effect (the seed is skipped once any user exists).
ORG_NAME=My Organization
ADMIN_EMAIL=admin@example.com
# Leave ADMIN_PASSWORD blank to have a strong password generated and printed
# once in the backend logs (docker compose logs backend). Or set your own.
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=
# Organization timezone, e.g. UTC, Asia/Manila, America/New_York.
TZ=UTC

# --- Email (SMTP), optional ---
# ursked sends invites, password-change confirmations and notifications by email.
# You can either fill these in and they will be seeded on first boot, or leave
# them blank and configure SMTP later in the app under Settings > Email (as a
# tenant admin). If SMTP_HOST is set, it seeds the mail config once; editing SMTP
# in-app afterwards takes precedence. With no SMTP configured, the app runs fine
# but simply does not send email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on port 587 (typical) vs implicit SSL on port 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ursked
